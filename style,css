* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  background: #f5f7fb;
  color: #172033;
  line-height: 1.6;
}

.navbar {
  height: 70px;
  padding: 0 6%;
  background: white;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid #e5e7eb;
  position: sticky;
  top: 0;
  z-index: 10;
}

.logo {
  font-size: 22px;
  font-weight: 800;
}

nav {
  display: flex;
  gap: 8px;
}

nav button,
.login-btn {
  border: none;
  background: transparent;
  padding: 10px 14px;
  cursor: pointer;
  font-weight: 600;
}

.login-btn {
  background: #111827;
  color: white;
  border-radius: 10px;
}

.page {
  display: none;
  max-width: 1200px;
  margin: auto;
  padding: 70px 6%;
  min-height: 650px;
}

.page.active {
  display: block;
}

.hero {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 70px;
  align-items: center;
  padding-top: 40px;
}

.badge,
.eyebrow,
.section-title > span {
  font-size: 13px;
  font-weight: 800;
  letter-spacing: 1px;
  text-transform: uppercase;
}

.hero h1 {
  font-size: clamp(45px, 6vw, 75px);
  line-height: 1.05;
  margin: 20px 0;
}

.hero h1 span {
  display: block;
}

.hero p {
  font-size: 19px;
  max-width: 650px;
  color: #5b6475;
  margin-bottom: 30px;
}

.primary {
  border: none;
  background: #111827;
  color: white;
  padding: 15px 25px;
  border-radius: 12px;
  font-weight: 700;
  cursor: pointer;
}

.dashboard-card,
.quiz-card,
.profile-card {
  background: white;
  border-radius: 24px;
  padding: 30px;
  box-shadow: 0 15px 50px rgba(0,0,0,.08);
}

.card-header {
  display: flex;
  justify-content: space-between;
}

.dashboard-card h2 {
  margin: 30px 0 15px;
}

.progress {
  height: 10px;
  background: #e5e7eb;
  border-radius: 20px;
  overflow: hidden;
}

.progress div {
  width: 0%;
  height: 100%;
  background: #111827;
  transition: .5s;
}

.lesson-preview {
  display: flex;
  gap: 15px;
  padding: 15px;
  margin-top: 12px;
  background: #f5f7fb;
  border-radius: 12px;
}

.lesson-preview small {
  display: block;
  color: #6b7280;
}

.stats {
  display: flex;
  gap: 20px;
  margin-top: 60px;
}

.stats div {
  background: white;
  padding: 20px 35px;
  border-radius: 15px;
  display: flex;
  flex-direction: column;
}

.stats strong {
  font-size: 30px;
}

.section-title {
  margin-bottom: 35px;
}

.section-title h2 {
  font-size: 42px;
  margin: 10px 0;
}

.levels {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 12px;
  margin-bottom: 35px;
}

.levels button {
  padding: 18px;
  border: 2px solid #e5e7eb;
  background: white;
  border-radius: 12px;
  font-weight: 800;
  cursor: pointer;
}

.levels button:hover {
  background: #111827;
  color: white;
}

.level-content {
  background: white;
  padding: 30px;
  border-radius: 18px;
  margin-bottom: 30px;
}

.features,
.community-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20px;
}

.features article,
.community-grid article {
  background: white;
  padding: 25px;
  border-radius: 18px;
  cursor: pointer;
  transition: .2s;
}

.features article:hover,
.community-grid article:hover {
  transform: translateY(-4px);
}

.features span {
  font-size: 35px;
}

.quiz-card {
  max-width: 700px;
  margin: auto;
}

.answers {
  display: grid;
  gap: 12px;
  margin-top: 25px;
}

.answers button {
  padding: 15px;
  background: #f5f7fb;
  border: 2px solid #e5e7eb;
  border-radius: 10px;
  cursor: pointer;
  text-align: left;
}

#quizResult {
  margin-top: 20px;
  font-weight: 800;
}

.profile-card {
  max-width: 500px;
  margin: auto;
  text-align: center;
}

.avatar {
  font-size: 70px;
}

.profile-stats {
  display: flex;
  justify-content: space-around;
  margin-top: 30px;
}

.profile-stats div {
  display: flex;
  flex-direction: column;
}

.profile-stats strong {
  font-size: 28px;
}

footer {
  text-align: center;
  padding: 40px 20px;
  background: #111827;
  color: white;
}

@media (max-width: 800px) {

  .navbar {
    height: auto;
    padding: 15px;
    flex-wrap: wrap;
    gap: 12px;
  }

  nav {
    width: 100%;
    overflow-x: auto;
  }

  nav button {
    white-space: nowrap;
  }

  .hero {
    grid-template-columns: 1fr;
    gap: 40px;
  }

  .features,
  .community-grid {
    grid-template-columns: 1fr 1fr;
  }

  .levels {
    grid-template-columns: repeat(3, 1fr);
  }

  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

}

@media (max-width: 500px) {

  .features,
  .community-grid {
    grid-template-columns: 1fr;
  }

  .hero h1 {
    font-size: 45px;
  }

}
